# Sunucu
PORT=3000
DATA_DIR=./data

# Gemini - ZORUNLU (transkript + varsayılan klip analizi)
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_ANALYSIS_MODEL=gemini-3-flash-preview

# Klip analizi sağlayıcısı: gemini (varsayılan) veya claude
AI_PROVIDER=gemini
# Sadece AI_PROVIDER=claude ise gerekli
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# YouTube'dan indirme (yt-dlp). Sadece işleme hakkına sahip olduğun videolar için aç.
ALLOW_YT_DOWNLOAD=false
